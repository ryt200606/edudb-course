// Public format 3 adapters. The caller holds strict catalog/table locks.
void Storage::write_table(const std::shared_ptr<Transaction>& tx,const std::string& name,const json& table){impl_->require_writable();
    if(!tx||!tx->state)throw DbError("NO_TRANSACTION","No transaction");std::lock_guard<std::recursive_mutex> guard(tx->state->mutex);auto& s=*impl_;s.require(tx);Impl::BackupWriteOperation operation(*impl_,tx);
    if(!table.contains("columns")||!table.contains("rows")||!table.at("rows").is_array())throw DbError("INVALID_TABLE","Table needs columns and rows");
    if(s.logical_mode){s.logical_pk(table);if(!table.at("rows").empty())throw DbError("LOGICAL_DDL_EMPTY","Logical-mode schema creation must precede separate DML transactions");s.logical_prepare_ddl(tx);}
    s.validate_record_table(table);s.cluster_validate_table(tx,table);
    auto cat=s.read_catalog(tx);bool created=!cat.contains(name);if(s.logical_mode&&!created)throw DbError("LOGICAL_UNSUPPORTED","Logical mode only permits fresh-table physical DDL");PageId owner=created?s.allocate(tx,TYPE_DESCRIPTOR):cat.at(name).get<PageId>();
    auto next_id=std::uint64_t(1);json old;bool rows_changed=created?!table.at("rows").empty():false;
    auto ids=table.value("row_ids",json::array());
    if(!created){
        old=s.descriptor(tx,name).second;next_id=old.value("next_row_id",std::uint64_t(1));
        rows_changed=old.at("row_count")!=table.at("rows").size();
        std::unordered_map<std::uint64_t,std::size_t> incoming;
        if(ids.size()==table.at("rows").size()){
            for(std::size_t i=0;i<ids.size();++i)
                if(!incoming.emplace(ids[i].get<std::uint64_t>(),i).second)throw DbError("INVALID_ROW","Duplicate rewrite row identity");
        }else rows_changed=true;
        {access::Index mapping(s.pager(tx,owner),old["row_map"]);
            for(const auto& entry:mapping.all()){
                auto encoded=s.stored_at(tx,owner,old,entry.id);auto position=incoming.find(entry.id);
                if(!rows_changed&&(position==incoming.end()||s.hydrate(tx,owner,encoded)!=table.at("rows")[position->second]))rows_changed=true;
                s.retire_objects(tx,owner,encoded);
            }
        }
        for(auto& ix:old["index_roots"])if(!ix.value("organization_alias",false)){access::Index index(s.pager(tx,owner),ix);index.clear();}
        s.cluster_remove_member(tx,owner,old);
        access::Index map(s.pager(tx,owner),old["row_map"]);map.clear();
        if(s.org_method(old)!="HEAP"){access::Index org(s.pager(tx,owner,true),old["organization_index"]);org.clear();}
        else for(const auto& id:old["heap"])s.retire(tx,id.get<PageId>());
    }
    {std::vector<PageId> discard;for(auto id:tx->state->new_pages)if(id!=owner&&get64(s.read_page(tx,id).data()+40)==owner)discard.push_back(id);for(auto id:discard)s.retire(tx,id);}
    json meta=table;for(auto field:{"rows","row_ids","row_count","heap_pages","index_stats","table_id","statistics","statistics_versions","data_version","schema_version","physical_version","physical_stats","record_layout","heap_pages_shared","row_count_scope","logical_visibility"})meta.erase(field);meta["indexes"]=table.value("indexes",json::array());auto org=s.org_definition(meta);meta["organization"]=org;if(meta.contains("cluster"))meta["cluster"]=s.resolve_cluster(tx,meta);
    auto versions=created?json{{"data_version",0},{"schema_version",1},{"physical_version",1}}:s.ch10_versions(old);
    const bool schema_changed=!created&&old.at("meta")!=meta;
    json desc={{"meta",meta},{"heap",json::array()},{"free_space",json::object()},{"index_roots",json::array()},{"row_count",0},{"next_row_id",next_id},{"organization",org},{"row_map",{{"method","BPLUS"},{"options",json::object()}}}};
    access::Index map(s.pager(tx,owner),desc["row_map"]);map.initialize();if(org["method"]!="HEAP"){auto d=org;d["method"]=org["method"]=="ORDERED"?json("ORDERED_SPARSE"):org["method"];desc["organization_index"]=d;access::Index index(s.pager(tx,owner,true),desc["organization_index"]);index.initialize();}
    s.cluster_attach_descriptor(tx,owner,desc);
    // Build after ingestion so CREATE/ALTER uses bottom-up bulk construction.
    auto indexes=desc["meta"]["indexes"];desc["meta"]["indexes"]=json::array();s.save_desc(tx,owner,desc);tx->state->descriptor_names[name]=owner;if(created){cat[name]=owner;s.save_catalog_tables(tx,cat);}s.set_cluster_route(tx,name,meta);
    std::size_t row_at=0;for(const auto& row:table.at("rows")){auto lid=row_at<ids.size()?ids[row_at].get<std::uint64_t>():0;s.v3_insert(tx,name,row,lid);++row_at;}set_indexes(tx,name,indexes);
    auto rewritten=s.descriptor(tx,name).second;
    for(const char* field:{"data_version","schema_version","physical_version"})rewritten[field]=versions.at(field);
    if(rows_changed)s.ch10_bump(rewritten,"data_version");
    if(schema_changed)s.ch10_bump(rewritten,"schema_version");
    if(!created)s.ch10_bump(rewritten,"physical_version");
    if(!created&&old.contains("statistics")){rewritten["statistics"]=old.at("statistics");rewritten["statistics_versions"]=old.value("statistics_versions",json::object());}
    tx->state->ch10_layout_touched.erase(owner);s.save_desc(tx,owner,rewritten);
    s.feed_emit(tx,name,"RESET",0,nullptr,nullptr);
}
void Storage::set_indexes(const std::shared_ptr<Transaction>& tx,const std::string& name,const json& indexes){impl_->require_writable();
    if(!tx||!tx->state)throw DbError("NO_TRANSACTION","No transaction");std::lock_guard<std::recursive_mutex> guard(tx->state->mutex);auto& s=*impl_;s.require(tx);Impl::BackupWriteOperation operation(*impl_,tx);s.logical_prepare_ddl(tx);auto pair=s.descriptor(tx,name);auto owner=pair.first;auto& d=pair.second;if(s.logical_mode){auto meta=d.at("meta");meta["indexes"]=indexes;s.logical_pk(meta);}
    json roots=json::array();std::set<std::string> names;
    for(const auto& raw:indexes){auto def=s.index_definition(d["meta"],raw);auto nm=def.at("name").get<std::string>();if(!names.insert(nm).second)throw DbError("DUPLICATE_INDEX","Duplicate index name");bool reused=false;for(auto& old:d["index_roots"])if(old.at("name")==nm){json previous;for(const auto& m:d["meta"]["indexes"])if(m.at("name")==nm){previous=s.index_definition(d["meta"],m);break;}auto a=previous,b=def;if(a==b){roots.push_back(old);reused=true;}break;}if(reused)continue;
        if(def["method"]=="ORDERED_SPARSE"){if(def.value("unique",false)){auto c=scan(tx,name);StoredRow r;json previous;while(c->next(r)){auto key=s.key_for(r.values,def["column_numbers"]);bool null=false;for(const auto& v:key)null|=v.is_null();if(null)continue;if(!previous.is_null()&&access::compare_keys(previous,key)==0)throw DbError("UNIQUE_VIOLATION","Existing duplicate sparse keys");previous=key;}}def["organization_alias"]=true;roots.push_back(def);continue;}
        s.bulk_index(tx,owner,def,scan(tx,name),d);roots.push_back(def);
    }
    for(auto& old:d["index_roots"]){bool keep=false;for(const auto& next:roots)if(next.at("name")==old.at("name")&&next.value("root",PageId(0))==old.value("root",PageId(0)))keep=true;if(!keep&&!old.value("organization_alias",false)){access::Index index(s.pager(tx,owner),old);index.clear();}}
    if(d.at("index_roots")==roots&&d.at("meta").at("indexes")==indexes)return;
    d["index_roots"]=roots;d["meta"]["indexes"]=indexes;s.ch10_bump(d,"schema_version");s.save_desc(tx,owner,d);
}
void Storage::reindex(const std::shared_ptr<Transaction>& tx,const std::string& name,const std::string& ixname){impl_->require_writable();if(!tx||!tx->state)throw DbError("NO_TRANSACTION","No transaction");std::lock_guard<std::recursive_mutex> guard(tx->state->mutex);auto& s=*impl_;s.require(tx);Impl::BackupWriteOperation operation(*impl_,tx);auto pair=s.descriptor(tx,name);auto owner=pair.first;auto& d=pair.second;bool found=ixname.empty(),rebuilt=false;for(auto& ix:d["index_roots"])if(ixname.empty()||ix.at("name")==ixname){found=true;if(ix.value("organization_alias",false))continue;json meta_def;for(const auto& m:d["meta"]["indexes"])if(m.at("name")==ix.at("name")){meta_def=m;break;}auto def=s.index_definition(d["meta"],meta_def);access::Index old(s.pager(tx,owner),ix);old.clear();ix=def;s.bulk_index(tx,owner,ix,scan(tx,name),d);rebuilt=true;}if(!found)throw DbError("INDEX_NOT_FOUND","Unknown index");if(rebuilt){tx->state->ch10_layout_touched.erase(owner);s.ch10_bump(d,"physical_version");s.save_desc(tx,owner,d);}}


