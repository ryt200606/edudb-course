}

std::vector<std::uint64_t> Storage::bitmap_selection(const std::shared_ptr<Transaction>& tx,PageId owner,json& d,const ScanSpec& spec){
    auto& s=*impl_;auto n=d.value("next_row_id",std::uint64_t(1));if(n>64u*1024u*1024u)throw DbError("QUERY_LIMIT_EXCEEDED","Bitmap working set limit exceeded");std::size_t words=static_cast<std::size_t>((n+63)/64);using Bits=std::vector<std::uint64_t>;Bits exists(words,0);json mask_descriptor;for(const auto& ix:d["index_roots"])if(ix.at("method")=="BITMAP"){mask_descriptor=ix.at("bitmap_masks");break;}if(mask_descriptor.is_null())throw DbError("INVALID_PLAN","Bitmap masks missing");access::Index masks(s.pager(tx,owner),mask_descriptor);auto access=s.pager(tx,owner);for(const auto& e:masks.all()){auto block=access.read(e.payload.at("page").get<PageId>());auto base=block.at("base").get<std::uint64_t>();for(std::size_t i=0;i<4;++i)if(base/64+i<exists.size())exists[base/64+i]|=block.at("existence")[i].get<std::uint64_t>();}
