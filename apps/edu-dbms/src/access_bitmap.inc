        if(base<oldbase){auto fresh=alloc(bitmap_container({e},id,hybrid,threshold));if(previous){auto prev=read(previous);prev["next"]=fresh;write(previous,prev);}else bitmap_directory_set(*this,e.key,fresh);bitmap_mask_change(*this,e,true);return;}
        if(base>oldbase||(next&&!entries.empty()&&entries.back().id<e.id)){if(next){auto np=read(next);auto nv=bitmap_values(np,e.key);if(!nv.empty()&&nv.front().id<=e.id){previous=id;id=next;continue;}}if(base>oldbase){auto fresh=alloc(bitmap_container({e},next,hybrid,threshold));page["next"]=fresh;write(id,page);bitmap_mask_change(*this,e,true);return;}}
        auto at=std::lower_bound(entries.begin(),entries.end(),e,[](const Entry& a,const Entry& b){return a.id<b.id;});if(at!=entries.end()&&at->id==e.id)throw DbError("DUPLICATE_INDEX_ENTRY","Duplicate bitmap row identifier");entries.insert(at,e);auto candidate=bitmap_container(entries,next,hybrid,threshold);if(planned_size(candidate)<=p.page_size_budget){if(page["mode"]!=candidate["mode"])stat("hybrid_conversions");write(id,candidate);bitmap_mask_change(*this,e,true);return;}
