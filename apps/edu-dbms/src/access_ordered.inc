namespace {
json ordered_page(const Node& n,bool compression,const std::string& kind){return {{"kind",kind},{"leaf",true},{"entries",pack_entries(n.entries,compression)},{"next",n.next},{"prev",n.prev}};}
void flat_dir_add(Index::Impl& x,json& desc,const Entry& e){
    Id id=desc.value("root",Id(0));if(!id){Node n;n.entries={e};desc["root"]=x.alloc(ordered_page(n,x.compression,"ordered_directory"));return;}
    for(int guard=0;guard<1000000;++guard){auto n=x.node(id);if(n.next&&!n.entries.empty()&&less(n.entries.back(),e)){auto next=x.node(n.next);if(!next.entries.empty()&&!less(e,next.entries.front())){id=n.next;continue;}}
        auto at=std::lower_bound(n.entries.begin(),n.entries.end(),e,less);if(at!=n.entries.end()&&!cmp(*at,e))throw DbError("DUPLICATE_INDEX_ENTRY","Duplicate ordered directory entry");n.entries.insert(at,e);
        if(n.entries.size()<=x.max_keys&&x.planned_size(ordered_page(n,x.compression,"ordered_directory"))<=x.p.page_size_budget){x.write(id,ordered_page(n,x.compression,"ordered_directory"));return;}
        auto split=x.split_point(n);Node right;right.entries.assign(n.entries.begin()+split,n.entries.end());n.entries.resize(split);right.prev=id;right.next=n.next;Id rid=x.alloc(ordered_page(right,x.compression,"ordered_directory"));n.next=rid;if(right.next){auto after=x.node(right.next);after.prev=rid;x.write(right.next,ordered_page(after,x.compression,"ordered_directory"));}x.write(id,ordered_page(n,x.compression,"ordered_directory"));x.stat("directory_splits");return;
    }bad("Flat directory cycle/size limit");
}
bool flat_dir_erase(Index::Impl& x,json& desc,const Entry& e){Id id=desc.value("root",Id(0));std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Directory cycle");auto n=x.node(id);auto at=std::lower_bound(n.entries.begin(),n.entries.end(),e,less);if(at!=n.entries.end()&&!cmp(*at,e)){n.entries.erase(at);if(n.entries.empty()){if(n.prev){auto prev=x.node(n.prev);prev.next=n.next;x.write(n.prev,ordered_page(prev,x.compression,"ordered_directory"));}else desc["root"]=n.next;if(n.next){auto next=x.node(n.next);next.prev=n.prev;x.write(n.next,ordered_page(next,x.compression,"ordered_directory"));}x.p.retire(id);}else x.write(id,ordered_page(n,x.compression,"ordered_directory"));return true;}if(at!=n.entries.end())return false;id=n.next;}return false;}
std::optional<Entry> flat_predecessor(Index::Impl& x,const json& desc,const Entry& target){std::optional<Entry> result;Id id=desc.value("root",Id(0));std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Directory cycle");auto n=x.node(id);for(const auto& e:n.entries){if(less(target,e))return result;result=e;}id=n.next;}return result;}
void ordered_directory_change(Index::Impl& x,Id page,const std::vector<Entry>& entries,bool remove){
    if(entries.empty())return;
    std::vector<Entry> references;if(x.method=="ORDERED_SPARSE")references.push_back({entries.front().key,entries.front().id,{{"page",page}}});else for(const auto& e:entries)references.push_back({e.key,e.id,{{"page",page}}});
    auto& desc=x.d["ordered_directory"];bool multi=x.options.value("multilevel",x.method=="ORDERED_SPARSE");
    if(multi){Index dir(x.p,desc);for(const auto& e:references){if(remove){if(!dir.erase(e.key,e.id))bad("Missing ordered directory entry");}else dir.insert(e);}}
    else for(const auto& e:references){if(remove){if(!flat_dir_erase(x,desc,e))bad("Missing flat ordered directory entry");}else flat_dir_add(x,desc,e);}
}
Id ordered_seek(Index::Impl& x,const Entry& target){auto& desc=x.d["ordered_directory"];std::optional<Entry> match;if(x.options.value("multilevel",x.method=="ORDERED_SPARSE")){Index::Impl inner(x.p,desc);match=inner.predecessor(target);}else match=flat_predecessor(x,desc,target);return match?match->payload.at("page").get<Id>():x.d.value("head",Id(0));}
}
void Index::Impl::ordered_init(){d["root"]=alloc({{"kind","ordered_control"},{"density",method=="ORDERED_DENSE"?"dense":"sparse"}});d["head"]=Id(0);d["ordered_directory"]={{"method","BPLUS"},{"options",{{"prefix_compression",compression},{"max_keys",max_keys}}}};if(options.value("multilevel",method=="ORDERED_SPARSE")){Index directory(p,d["ordered_directory"]);directory.initialize();}}
void Index::Impl::ordered_add(const Entry& e){auto id=ordered_seek(*this,e);if(!id){Node n;n.entries={e};id=alloc(ordered_page(n,compression,"ordered_data"));d["head"]=id;ordered_directory_change(*this,id,n.entries,false);return;}auto n=node(id);auto old=n.entries;auto at=std::lower_bound(n.entries.begin(),n.entries.end(),e,less);if(at!=n.entries.end()&&!cmp(*at,e))throw DbError("DUPLICATE_INDEX_ENTRY","Duplicate ordered key/row id");n.entries.insert(at,e);ordered_directory_change(*this,id,old,true);
    if(n.entries.size()<=max_keys&&planned_size(ordered_page(n,compression,"ordered_data"))<=p.page_size_budget){write(id,ordered_page(n,compression,"ordered_data"));ordered_directory_change(*this,id,n.entries,false);return;}
    auto split=split_point(n);Node right;right.entries.assign(n.entries.begin()+split,n.entries.end());n.entries.resize(split);right.next=n.next;right.prev=id;Id rid=alloc(ordered_page(right,compression,"ordered_data"));n.next=rid;if(right.next){auto after=node(right.next);after.prev=rid;write(right.next,ordered_page(after,compression,"ordered_data"));}write(id,ordered_page(n,compression,"ordered_data"));ordered_directory_change(*this,id,n.entries,false);ordered_directory_change(*this,rid,right.entries,false);stat("splits");
}
bool Index::Impl::ordered_erase(const Entry& e){auto id=ordered_seek(*this,e);if(!id)return false;auto n=node(id);auto at=std::lower_bound(n.entries.begin(),n.entries.end(),e,less);if(at==n.entries.end()||cmp(*at,e))return false;auto old=n.entries;n.entries.erase(at);ordered_directory_change(*this,id,old,true);
    if(n.entries.empty()){if(n.prev){auto prev=node(n.prev);prev.next=n.next;write(n.prev,ordered_page(prev,compression,"ordered_data"));}else d["head"]=n.next;if(n.next){auto next=node(n.next);next.prev=n.prev;write(n.next,ordered_page(next,compression,"ordered_data"));}p.retire(id);stat("merges");return true;}
    if(n.next){auto right=node(n.next);auto combined=n;combined.entries.insert(combined.entries.end(),right.entries.begin(),right.entries.end());combined.next=right.next;if(combined.entries.size()<=max_keys&&planned_size(ordered_page(combined,compression,"ordered_data"))<=p.page_size_budget){ordered_directory_change(*this,n.next,right.entries,true);Id retired=n.next;if(right.next){auto after=node(right.next);after.prev=id;write(right.next,ordered_page(after,compression,"ordered_data"));}p.retire(retired);n=std::move(combined);stat("merges");}}
    write(id,ordered_page(n,compression,"ordered_data"));ordered_directory_change(*this,id,n.entries,false);return true;
}
std::vector<Entry> Index::Impl::ordered_all(){return ordered_range({},{},true,true,std::numeric_limits<std::size_t>::max());}
std::vector<Entry> Index::Impl::ordered_range(const std::optional<Key>& low,const std::optional<Key>& high,bool li,bool ui,std::size_t limit){std::vector<Entry> out;if(!limit)return out;auto id=low?ordered_seek(*this,{*low,0,nullptr}):d.value("head",Id(0));std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Ordered data cycle");auto n=node(id);for(const auto& e:n.entries){auto a=low?compare_keys(e.key,*low):1,b=high?compare_keys(e.key,*high):-1;if(low&&(a<0||(!li&&!a)))continue;if(high&&(b>0||(!ui&&!b)))return out;out.push_back(e);if(out.size()==limit)return out;}id=n.next;}return out;}
