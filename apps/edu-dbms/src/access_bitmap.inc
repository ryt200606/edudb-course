constexpr Id BITMAP_BLOCK=256;
json bitmap_container(const std::vector<Entry>& entries,Id next,bool hybrid,std::size_t threshold){
    Id base=entries.empty()?0:(entries.front().id/BITMAP_BLOCK)*BITMAP_BLOCK;json rows=json::array(),words=json::array({Id(0),Id(0),Id(0),Id(0)}),ids=json::array();
    for(const auto& e:entries){if(e.id<base||e.id>=base+BITMAP_BLOCK)bad("Bitmap container crosses block");rows.push_back(json::array({e.id,e.payload}));auto bit=e.id-base;words[bit/64]=words[bit/64].get<Id>()|(Id(1)<<(bit%64));ids.push_back(e.id);}
    json bitmap={{"kind","bitmap_posting"},{"mode","bitmap"},{"base",base},{"next",next},{"values",rows},{"words",words}};
    json list={{"kind","bitmap_posting"},{"mode","list"},{"base",base},{"next",next},{"values",rows},{"ids",ids}};
    if(!hybrid)return bitmap;
    if(threshold)return entries.size()>=threshold?bitmap:list;
    return bitmap.dump().size()<list.dump().size()?bitmap:list;
}
std::vector<Entry> bitmap_values(const json& page,const Key& key){
    std::map<Id,json> payloads;for(const auto& value:page.at("values")){auto id=value.at(0).get<Id>();if(!payloads.emplace(id,value.at(1)).second)bad("Duplicate posting payload");}
    std::vector<Entry> out;if(page.at("mode")=="bitmap"){auto base=page.at("base").get<Id>();if(page.at("words").size()!=4)bad("Invalid bitmap word count");for(unsigned word=0;word<4;++word){Id bits=page["words"][word].get<Id>();for(unsigned b=0;b<64;++b)if(bits&(Id(1)<<b)){auto id=base+word*64+b;auto found=payloads.find(id);if(found==payloads.end())bad("Bitmap bit lacks payload");out.push_back({key,id,found->second});}}}
    else if(page.at("mode")=="list"){for(auto id:page.at("ids")){auto found=payloads.find(id.get<Id>());if(found==payloads.end())bad("Posting list lacks payload");out.push_back({key,found->first,found->second});}}else bad("Invalid posting encoding");
    if(out.size()!=payloads.size())bad("Unreachable posting payload");
    return out;
}
void bitmap_directory_set(Index::Impl& x,const Key& key,Id head){Index dict(x.p,x.d["bitmap_dictionary"]);auto existing=dict.find(key);if(!existing.empty())dict.erase(key,0);if(head)dict.insert({key,0,{{"head",head}}});}
void bitmap_mask_change(Index::Impl& x,const Entry& e,bool present){auto base=(e.id/BITMAP_BLOCK)*BITMAP_BLOCK;Index dict(x.p,x.d["bitmap_masks"]);Key key=json::array({base});auto found=dict.find(key);Id id;json page;if(found.empty()){if(!present)bad("Missing bitmap existence block");page={{"kind","bitmap_masks"},{"base",base},{"existence",json::array({Id(0),Id(0),Id(0),Id(0)})},{"nulls",json::array({Id(0),Id(0),Id(0),Id(0)})}};id=x.alloc(page);dict.insert({key,0,{{"page",id}}});}else{id=found.front().payload.at("page");page=x.read(id);}auto bit=e.id-base,word=bit/64,mask=Id(1)<<(bit%64);auto before=page["existence"][word].get<Id>();bool null=false;for(const auto& v:e.key)null=null||v.is_null();page["existence"][word]=present?before|mask:before&~mask;auto old=page["nulls"][word].get<Id>();page["nulls"][word]=present&&null?old|mask:old&~mask;x.write(id,page);}
}
