}
std::optional<std::uint64_t> Storage::count(const std::shared_ptr<Transaction>& tx,const std::string& name,const ScanSpec& spec){if(spec.mode!="BITMAP")return {};if(!tx||!tx->state)throw DbError("NO_TRANSACTION","No transaction");std::lock_guard<std::recursive_mutex> guard(tx->state->mutex);impl_->require(tx);auto pair=impl_->descriptor(tx,name);auto bits=bitmap_selection(tx,pair.first,pair.second,spec);std::uint64_t count=0;for(auto v:bits)while(v){v&=v-1;++count;}return count;}
json Storage::index_scan(const std::shared_ptr<Transaction>& tx,const std::string& name,const std::string& index,const std::string& op,std::int64_t key){compare(0,op,0);ScanSpec spec;spec.index=index;auto meta=read_table(tx,name,false);for(std::size_t i=0;i<meta["columns"].size();++i)spec.required_columns.push_back(static_cast<int>(i));if(op=="="||op==">"||op==">="){spec.lower=key;spec.lower_inclusive=op!=">";}if(op=="="||op=="<"||op=="<="){spec.upper=key;spec.upper_inclusive=op!="<";}auto cursor=scan(tx,name,spec);json rows=json::array();StoredRow row;std::size_t col=0;for(const auto& ix:meta["indexes"])if(ix["name"]==index){auto cols=Impl::column_numbers(meta,ix.contains("columns")?ix["columns"]:json::array({ix["column"]}));col=cols[0];}while(cursor->next(row))if(!row.values[col].is_null()&&compare(row.values[col].get<std::int64_t>(),op,key))rows.push_back(row.values);return rows;}
json Storage::inspect(const std::shared_ptr<Transaction>& tx,const std::string& name,const std::string& nm,std::size_t limit){if(!tx||!tx->state)throw DbError("NO_TRANSACTION","No transaction");std::lock_guard<std::recursive_mutex> guard(tx->state->mutex);auto& s=*impl_;s.require(tx);if(!limit||limit>2048)throw DbError("ARGUMENT","max_pages must be 1..2048");auto pair=s.descriptor(tx,name);auto owner=pair.first;auto& d=pair.second;json shape,caps;auto org=s.org_method(d);
