void Index::Impl::bitmap_add(const Entry& e){Index dictionary(p,d["bitmap_dictionary"]);auto found=dictionary.find(e.key);Id head=found.empty()?0:found.front().payload.at("head").get<Id>();bool hybrid=options.value("hybrid",true);auto threshold=options.value("bitmap_threshold",0u);if((options.contains("bitmap_threshold")&&!threshold)||threshold>BITMAP_BLOCK)throw DbError("INDEX_CONFIG","Explicit bitmap threshold must be 1..256");
    if(!head){auto page=bitmap_container({e},0,hybrid,threshold);head=alloc(page);bitmap_directory_set(*this,e.key,head);bitmap_mask_change(*this,e,true);stat(page["mode"]=="bitmap"?"bitmap_containers":"list_containers");return;}
