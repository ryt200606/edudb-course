        auto column=ast.at("column").get<int>();json* selected=nullptr;for(auto& ix:d["index_roots"])if(ix["method"]=="BITMAP"&&ix["column_numbers"].size()==1&&ix["column_numbers"][0]==column){selected=&ix;break;}if(!selected)throw DbError("INVALID_PLAN","Bitmap predicate lacks a bitmap index");Truth a{zero(),zero()};access::Index index(s.pager(tx,owner),*selected);auto entries=index.all();for(const auto& e:entries){json row=json::array();for(std::size_t i=0;i<d["meta"]["columns"].size();++i)row.push_back(nullptr);row[column]=e.key[0];int value=Impl::condition_truth(ast,row);auto bit=std::uint64_t(1)<<(e.id%64);if(value==1)a.t[e.id/64]|=bit;else if(value<0)a.u[e.id/64]|=bit;}return a;
