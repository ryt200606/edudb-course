namespace {
json posting_page(const std::vector<Entry>& entries,Id next){json values=json::array();for(const auto& e:entries)values.push_back(json::array({e.id,e.payload}));return {{"kind","posting_list"},{"values",values},{"next",next}};}
std::vector<Entry> posting_values(const json& page,const Key& key){std::vector<Entry> entries;for(const auto& value:page.at("values"))entries.push_back({key,value.at(0).get<Id>(),value.at(1)});if(!std::is_sorted(entries.begin(),entries.end(),less))bad("Unordered posting bucket");return entries;}
void posting_head_set(Index::Impl& x,const Key& key,Id head){Index dictionary(x.p,x.d["posting_dictionary"]);auto found=dictionary.find(key);if(!found.empty())dictionary.erase(key,0);if(head)dictionary.insert({key,0,{{"head",head}}});}
}
void Index::Impl::posting_init(){d["root"]=alloc({{"kind","posting_control"},{"key_storage","one dictionary entry per distinct key"}});d["posting_dictionary"]={{"method","BPLUS"},{"options",{{"prefix_compression",compression},{"max_keys",max_keys}}}};Index dictionary(p,d["posting_dictionary"]);dictionary.initialize();}
void Index::Impl::posting_add(const Entry& e){Index dictionary(p,d["posting_dictionary"]);auto found=dictionary.find(e.key);Id id=found.empty()?0:found.front().payload.at("head").get<Id>();if(!id){id=alloc(posting_page({e},0));posting_head_set(*this,e.key,id);return;}std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Posting bucket cycle");auto page=read(id);auto entries=posting_values(page,e.key);auto next=page.value("next",Id(0));if(next&&!entries.empty()&&entries.back().id<e.id){auto after=read(next);auto values=posting_values(after,e.key);if(!values.empty()&&values.front().id<=e.id){id=next;continue;}}auto it=std::lower_bound(entries.begin(),entries.end(),e,less);if(it!=entries.end()&&!cmp(*it,e))throw DbError("DUPLICATE_INDEX_ENTRY","Duplicate posting row identifier");entries.insert(it,e);if(planned_size(posting_page(entries,next))<=p.page_size_budget){write(id,posting_page(entries,next));return;}auto mid=entries.size()/2;std::vector<Entry> right(entries.begin()+mid,entries.end());entries.resize(mid);Id rid=alloc(posting_page(right,next));write(id,posting_page(entries,rid));stat("posting_splits");return;}bad("Missing posting bucket");}
bool Index::Impl::posting_erase(const Entry& e){Index dictionary(p,d["posting_dictionary"]);auto found=dictionary.find(e.key);if(found.empty())return false;Id id=found.front().payload.at("head"),previous=0;std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Posting bucket cycle");auto page=read(id);auto entries=posting_values(page,e.key);auto it=std::lower_bound(entries.begin(),entries.end(),e,less);if(it!=entries.end()&&!cmp(*it,e)){entries.erase(it);auto next=page.value("next",Id(0));if(entries.empty()){if(previous){auto before=read(previous);before["next"]=next;write(previous,before);}else posting_head_set(*this,e.key,next);p.retire(id);}else write(id,posting_page(entries,next));return true;}previous=id;id=page.value("next",Id(0));}return false;}
std::vector<Entry> Index::Impl::posting_find(const Key& key){Index dictionary(p,d["posting_dictionary"]);auto found=dictionary.find(key);if(found.empty())return {};std::vector<Entry> out;Id id=found.front().payload.at("head");std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Posting bucket cycle");auto page=read(id);auto entries=posting_values(page,key);out.insert(out.end(),entries.begin(),entries.end());id=page.value("next",Id(0));}return out;}
std::vector<Entry> Index::Impl::posting_all(){Index dictionary(p,d["posting_dictionary"]);std::vector<Entry> out;for(const auto& key:dictionary.all()){auto entries=posting_find(key.key);out.insert(out.end(),entries.begin(),entries.end());}return out;}
