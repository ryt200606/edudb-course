// Included inside namespace edudb::access after Index::Impl.
namespace {
constexpr std::size_t DIR_CHUNK=128;
json hash_bucket(const std::vector<Entry>& entries,int depth,Id next=0){return {{"kind","hash_bucket"},{"depth",depth},{"next",next},{"entries",pack_entries(entries,false)}};}
}
void Index::Impl::hash_init(){
    auto buckets=options.value("buckets",16u);if(!buckets||buckets>65536)throw DbError("INDEX_CONFIG","Hash buckets must be in 1..65536");
    if(options.value("max_depth",20)>20||options.value("max_depth",20)<1)throw DbError("INDEX_CONFIG","Extensible hash max_depth must be in 1..20");
    d["root"]=alloc({{"kind","hash_control"},{"algorithm",method}});d["directory_pages"]=json::array();d["directory_size"]=0;d["global_depth"]=0;d["level"]=0;d["split_pointer"]=0;d["base_buckets"]=buckets;
    std::vector<Id> roots;if(method=="HASH_EXTENDIBLE")roots.push_back(alloc(hash_bucket({},0)));else for(unsigned i=0;i<buckets;++i){if(method=="HASH_STATIC"&&options.value("probing",false)){json slots=json::array();for(std::size_t j=0;j<max_keys;++j)slots.push_back(nullptr);roots.push_back(alloc({{"kind","hash_probe"},{"slots",slots}}));}else roots.push_back(alloc(hash_bucket({},0)));}
    for(std::size_t i=0;i<roots.size();i+=DIR_CHUNK){json values=json::array();for(auto j=i;j<std::min(roots.size(),i+DIR_CHUNK);++j)values.push_back(roots[j]);d["directory_pages"].push_back(alloc({{"kind","hash_directory"},{"values",values}}));}d["directory_size"]=roots.size();
}
// Directory pages are independent pages. Point lookup reads exactly one
// directory page, rather than materializing a million-entry JSON directory.
namespace {
Id dir_at(Index::Impl& x,std::size_t at){if(at>=x.d.at("directory_size").get<std::size_t>())bad("Directory offset out of range");auto page=x.read(x.d["directory_pages"][at/DIR_CHUNK]);return page.at("values").at(at%DIR_CHUNK).get<Id>();}
void dir_set(Index::Impl& x,std::size_t at,Id value){auto id=x.d["directory_pages"][at/DIR_CHUNK].get<Id>();auto page=x.read(id);page["values"].at(at%DIR_CHUNK)=value;x.write(id,page);}
std::vector<Id> directory(Index::Impl& x){std::vector<Id> out;for(auto id:x.d["directory_pages"]){auto p=x.read(id);for(auto value:p.at("values"))out.push_back(value.get<Id>());}if(out.size()!=x.d.at("directory_size").get<std::size_t>())bad("Hash directory length mismatch");return out;}
void dir_replace(Index::Impl& x,const std::vector<Id>& values){auto old=x.d["directory_pages"];x.d["directory_pages"]=json::array();for(std::size_t i=0;i<values.size();i+=DIR_CHUNK){json part=json::array();for(auto j=i;j<std::min(values.size(),i+DIR_CHUNK);++j)part.push_back(values[j]);x.d["directory_pages"].push_back(x.alloc({{"kind","hash_directory"},{"values",part}}));}x.d["directory_size"]=values.size();for(auto id:old)x.p.retire(id);}
std::size_t hash_slot(Index::Impl& x,Id h){if(x.method=="HASH_EXTENDIBLE"){auto depth=x.d.at("global_depth").get<unsigned>();return depth?static_cast<std::size_t>(h>>(64-depth)):0;}if(x.method=="HASH_LINEAR"){auto base=x.d.at("base_buckets").get<std::size_t>()<<x.d.at("level").get<unsigned>();auto at=static_cast<std::size_t>(h%base);if(at<x.d.at("split_pointer").get<std::size_t>())at=static_cast<std::size_t>(h%(base*2));return at;}return static_cast<std::size_t>(h%x.d.at("directory_size").get<std::size_t>());}
std::vector<Entry> bucket_entries(Index::Impl& x,Id root,std::vector<Id>* ids=nullptr){std::vector<Entry> out;std::set<Id> seen;while(root){if(!seen.insert(root).second)bad("Hash overflow cycle");auto page=x.read(root);if(page.value("kind","")!="hash_bucket")bad("Not a hash bucket");auto depth=page.at("depth").get<int>();if(depth<0||depth>20||(x.method=="HASH_EXTENDIBLE"&&depth>x.d.at("global_depth").get<int>()))bad("Invalid bucket local depth");if(ids)ids->push_back(root);auto es=unpack_entries(page.at("entries"));out.insert(out.end(),es.begin(),es.end());root=page.value("next",Id(0));}return out;}
void bucket_rewrite(Index::Impl& x,Id root,std::vector<Entry> entries,int depth){std::vector<Id> old;bucket_entries(x,root,&old);std::sort(entries.begin(),entries.end(),less);std::vector<std::vector<Entry>> chunks(1);for(const auto& e:entries){auto candidate=chunks.back();candidate.push_back(e);if(candidate.size()>x.max_keys||x.planned_size(hash_bucket(candidate,depth))>x.p.page_size_budget){if(chunks.back().empty())throw DbError("INDEX_ENTRY_TOO_LARGE","Hash entry cannot fit bucket");chunks.push_back({e});}else chunks.back().push_back(e);}std::vector<Id> pages{root};for(std::size_t i=1;i<chunks.size();++i)pages.push_back(i<old.size()?old[i]:x.alloc(hash_bucket({},depth)));for(std::size_t i=0;i<chunks.size();++i)x.write(pages[i],hash_bucket(chunks[i],depth,i+1<pages.size()?pages[i+1]:0));for(std::size_t i=chunks.size();i<old.size();++i)x.p.retire(old[i]);}
bool bucket_append(Index::Impl& x,Id root,const Entry& entry){
    // The sorted-input gate validates every (key,id) before calling insert, so
    // a temporary tail cache can avoid rewalking an ever-growing static chain.
    // Ordinary DML continues to check the complete bucket for duplicates.
    if(x.sorted_static_stream){auto found=x.bulk_tails.find(root);auto tail=found==x.bulk_tails.end()?root:found->second;auto page=x.read(tail);auto entries=unpack_entries(page.at("entries"));entries.push_back(entry);auto out=hash_bucket(entries,page.value("depth",0));if(entries.size()<=x.max_keys&&x.planned_size(out)<=x.p.page_size_budget){x.write(tail,out);x.bulk_tails[root]=tail;x.stat("bulk_tail_appends");return true;}auto fresh=x.alloc(hash_bucket({entry},page.value("depth",0)));page["next"]=fresh;x.write(tail,page);x.bulk_tails[root]=fresh;x.stat("overflow_pages");x.stat("bulk_tail_appends");return false;}
    for(const auto& e:bucket_entries(x,root))if(!cmp(e,entry))throw DbError("DUPLICATE_INDEX_ENTRY","Duplicate hash key/row id");
    std::set<Id> seen;while(root){if(!seen.insert(root).second)bad("Hash overflow cycle");auto page=x.read(root);auto es=unpack_entries(page.at("entries"));auto candidate=es;candidate.push_back(entry);auto out=hash_bucket(candidate,page.value("depth",0),page.value("next",Id(0)));if(candidate.size()<=x.max_keys&&x.planned_size(out)<=x.p.page_size_budget){x.write(root,out);return true;}auto next=page.value("next",Id(0));if(!next){auto id=x.alloc(hash_bucket({entry},page.value("depth",0)));page["next"]=id;x.write(root,page);x.stat("overflow_pages");return false;}root=next;}bad("Missing hash root");}
}
void Index::Impl::hash_add(const Entry& e){
    auto h=key_hash(e.key),slot=hash_slot(*this,h);Id root=dir_at(*this,slot);
    if(method=="HASH_STATIC"&&options.value("probing",false)){
        auto count=d["directory_size"].get<std::size_t>()*max_keys,start=static_cast<std::size_t>(h%count);std::optional<std::pair<Id,std::size_t>> available;
        std::size_t probes=0;for(std::size_t distance=0;distance<count;++distance){++probes;auto position=(start+distance)%count;auto id=dir_at(*this,position/max_keys);auto page=read(id);auto cell=page["slots"][position%max_keys];if(cell.is_array()){if(!cmp(parse_entry(cell),e))throw DbError("DUPLICATE_INDEX_ENTRY","Duplicate probing key/row id");continue;}if(!available)available=std::make_pair(id,position%max_keys);if(cell.is_null())break;}
        if(!available)throw DbError("INDEX_RESOURCE","Static linear-probing array is full");
        auto page=read(available->first);bool tombstone=page["slots"][available->second].is_object();page["slots"][available->second]=raw_entry(e);write(available->first,page);stat("probes",probes);if(tombstone)stat("tombstones_reused");return;
    }
    if(method=="HASH_EXTENDIBLE"){
        for(unsigned attempts=0;attempts<21;++attempts){slot=hash_slot(*this,h);root=dir_at(*this,slot);auto page=read(root);auto entries=bucket_entries(*this,root);for(const auto& old:entries)if(!cmp(old,e))throw DbError("DUPLICATE_INDEX_ENTRY","Duplicate extensible key/row id");auto candidate=entries;candidate.push_back(e);
            if(!page.value("next",Id(0))&&candidate.size()<=max_keys&&planned_size(hash_bucket(candidate,page.value("depth",0)))<=p.page_size_budget){write(root,hash_bucket(candidate,page.value("depth",0)));return;}
            auto local=page.value("depth",0),global=d["global_depth"].get<int>(),maximum=options.value("max_depth",20);bool same=true;for(const auto& old:entries)if(key_hash(old.key)!=h){same=false;break;}
            if(local>=maximum||same){bucket_append(*this,root,e);stat(same?"same_hash_overflows":"depth_limit_overflows");return;}
            Id differing=0;for(const auto& old:entries)differing|=key_hash(old.key)^h;
            if(!(differing>>(64-maximum))){bucket_append(*this,root,e);stat("prefix_limit_overflows");return;}
            if(local==global){auto dirs=directory(*this);std::vector<Id> expanded;expanded.reserve(dirs.size()*2);for(auto id:dirs){expanded.push_back(id);expanded.push_back(id);}dir_replace(*this,expanded);d["global_depth"]=++global;stat("directory_doubles");}
            auto right=alloc(hash_bucket({},local+1));std::vector<Entry> left_entries,right_entries;for(const auto& old:entries)((key_hash(old.key)>>(63-local))&1?right_entries:left_entries).push_back(old);
            bucket_rewrite(*this,root,std::move(left_entries),local+1);bucket_rewrite(*this,right,std::move(right_entries),local+1);
            auto prefix=local?h>>(64-local):0;auto first=static_cast<std::size_t>(prefix)<<(global-local),length=std::size_t(1)<<(global-local);for(auto i=first;i<first+length;++i)dir_set(*this,i,i<first+length/2?root:right);stat("bucket_splits");
        }throw DbError("INDEX_RESOURCE","Extensible hash split budget exhausted");
    }
    bool no_overflow=bucket_append(*this,root,e);
    if(method=="HASH_LINEAR"&&!no_overflow){auto base=d["base_buckets"].get<std::size_t>()<<d["level"].get<unsigned>(),split=d["split_pointer"].get<std::size_t>();if(base>=(std::size_t(1)<<20))return;auto old=dir_at(*this,split);auto fresh=alloc(hash_bucket({},0));auto dirs=directory(*this);dirs.push_back(fresh);dir_replace(*this,dirs);auto values=bucket_entries(*this,old);std::vector<Entry> a,b;for(const auto& value:values)(key_hash(value.key)%(base*2)==split?a:b).push_back(value);bucket_rewrite(*this,old,std::move(a),0);bucket_rewrite(*this,fresh,std::move(b),0);++split;if(split==base){split=0;d["level"]=d["level"].get<unsigned>()+1;}d["split_pointer"]=split;stat("bucket_splits");}
}
std::vector<Entry> Index::Impl::hash_find(const Key& key){auto slot=hash_slot(*this,key_hash(key));std::vector<Entry> out;auto collect=[&](Id id){for(const auto& e:bucket_entries(*this,id))if(!compare_keys(e.key,key))out.push_back(e);};if(method=="HASH_STATIC"&&options.value("probing",false)){auto count=d["directory_size"].get<std::size_t>()*max_keys,start=key_hash(key)%count;for(std::size_t distance=0;distance<count;++distance){auto position=(start+distance)%count;auto page=read(dir_at(*this,position/max_keys));auto cell=page["slots"][position%max_keys];stat("lookup_probes");if(cell.is_null())break;if(cell.is_array()){auto e=parse_entry(cell);if(!compare_keys(e.key,key))out.push_back(e);}}}else collect(dir_at(*this,slot));std::sort(out.begin(),out.end(),less);return out;}
bool Index::Impl::hash_erase(const Entry& e){auto slot=hash_slot(*this,key_hash(e.key));Id root=dir_at(*this,slot);bool removed=false;
    auto erase_chain=[&](Id id){std::set<Id> seen;Id previous=0;while(id){if(!seen.insert(id).second)bad("Hash erase cycle");auto page=read(id);auto entries=unpack_entries(page["entries"]);auto it=std::find_if(entries.begin(),entries.end(),[&](const Entry& value){return !cmp(value,e);});if(it!=entries.end()){entries.erase(it);page["entries"]=pack_entries(entries,false);auto next=page.value("next",Id(0));if(entries.empty()&&previous){auto before=read(previous);before["next"]=next;write(previous,before);p.retire(id);stat("overflow_reclaims");}else if(entries.empty()&&next){auto replacement=read(next);replacement["depth"]=page.value("depth",0);write(id,replacement);p.retire(next);stat("overflow_reclaims");}else write(id,page);return true;}previous=id;id=page.value("next",Id(0));}return false;};
    if(method=="HASH_STATIC"&&options.value("probing",false)){auto count=d["directory_size"].get<std::size_t>()*max_keys,start=key_hash(e.key)%count;for(std::size_t distance=0;distance<count;++distance){auto position=(start+distance)%count,id=dir_at(*this,position/max_keys);auto page=read(id);auto& cell=page["slots"][position%max_keys];if(cell.is_null())return false;if(cell.is_array()&&!cmp(parse_entry(cell),e)){cell={{"tombstone",true}};write(id,page);stat("tombstones");return true;}}return false;}else removed=erase_chain(root);
    if(!removed||method!="HASH_EXTENDIBLE")return removed;
    for(int attempt=0;attempt<20;++attempt){auto page=read(root);auto local=page.value("depth",0),global=d["global_depth"].get<int>();if(!local)break;slot=hash_slot(*this,key_hash(e.key));auto buddy_slot=slot^(std::size_t(1)<<(global-local));auto buddy=dir_at(*this,buddy_slot);if(buddy==root)bad("Extensible hash buddy aliases itself");auto bp=read(buddy);if(bp.value("depth",0)!=local)break;auto combined=bucket_entries(*this,root),other=bucket_entries(*this,buddy);combined.insert(combined.end(),other.begin(),other.end());if(combined.size()>max_keys||planned_size(hash_bucket(combined,local-1))>p.page_size_budget)break;Id keep=slot<buddy_slot?root:buddy,drop=slot<buddy_slot?buddy:root;bucket_rewrite(*this,keep,std::move(combined),local-1);std::vector<Id> dropped;bucket_entries(*this,drop,&dropped);for(auto id:dropped)p.retire(id);auto first=(std::min(slot,buddy_slot)>>(global-local+1))<<(global-local+1);auto length=std::size_t(1)<<(global-local+1);for(auto i=first;i<first+length;++i)dir_set(*this,i,keep);root=keep;stat("bucket_merges");
        while(d["global_depth"].get<int>()>0){auto dirs=directory(*this);bool shrink=true;for(std::size_t i=0;i<dirs.size();i+=2)if(dirs[i]!=dirs[i+1]){shrink=false;break;}if(!shrink)break;std::vector<Id> half;for(std::size_t i=0;i<dirs.size();i+=2)half.push_back(dirs[i]);dir_replace(*this,half);d["global_depth"]=d["global_depth"].get<int>()-1;stat("directory_shrinks");}
    }return true;
}
std::vector<Entry> Index::Impl::hash_all(){std::vector<Entry> out;std::set<Id> seen;for(auto root:directory(*this))if(seen.insert(root).second){if(method=="HASH_STATIC"&&options.value("probing",false)){auto page=read(root);for(const auto& cell:page.at("slots"))if(cell.is_array())out.push_back(parse_entry(cell));}else{auto values=bucket_entries(*this,root);out.insert(out.end(),values.begin(),values.end());}}std::sort(out.begin(),out.end(),less);return out;}
