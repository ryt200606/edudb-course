json Storage::blob_value(const std::shared_ptr<Transaction>& tx,const json& reference,std::uint64_t start,std::uint64_t length){
    if(!tx||!tx->state)throw DbError("NO_TRANSACTION","No transaction");std::lock_guard<std::recursive_mutex> guard(tx->state->mutex);auto& s=*impl_;s.require(tx);if(!start)throw DbError("FUNCTION_ARGUMENT","BLOB offset is one based");
