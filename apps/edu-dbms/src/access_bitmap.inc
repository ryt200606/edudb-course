}
bool Index::Impl::bitmap_erase(const Entry& e){Index dictionary(p,d["bitmap_dictionary"]);auto found=dictionary.find(e.key);if(found.empty())return false;Id head=found.front().payload.at("head"),id=head,previous=0;std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Posting cycle");auto page=read(id);auto entries=bitmap_values(page,e.key);auto it=std::find_if(entries.begin(),entries.end(),[&](const Entry& row){return row.id==e.id;});if(it!=entries.end()){entries.erase(it);auto next=page.value("next",Id(0));if(entries.empty()){if(previous){auto prev=read(previous);prev["next"]=next;write(previous,prev);}else bitmap_directory_set(*this,e.key,next);p.retire(id);}else{auto out=bitmap_container(entries,next,options.value("hybrid",true),options.value("bitmap_threshold",0u));if(out["mode"]!=page["mode"])stat("hybrid_conversions");write(id,out);}bitmap_mask_change(*this,e,false);return true;}previous=id;id=page.value("next",Id(0));}return false;}
std::vector<Entry> Index::Impl::bitmap_find(const Key& key){Index dictionary(p,d["bitmap_dictionary"]);auto found=dictionary.find(key);if(found.empty())return {};std::vector<Entry> out;Id id=found.front().payload.at("head");std::set<Id> seen;while(id){if(!seen.insert(id).second)bad("Posting cycle");auto page=read(id);auto rows=bitmap_values(page,key);out.insert(out.end(),rows.begin(),rows.end());id=page.value("next",Id(0));}std::sort(out.begin(),out.end(),less);return out;}
std::vector<Entry> Index::Impl::bitmap_all(){Index dictionary(p,d["bitmap_dictionary"]);std::vector<Entry> out;for(const auto& e:dictionary.all()){auto rows=bitmap_find(e.key);out.insert(out.end(),rows.begin(),rows.end());}std::sort(out.begin(),out.end(),less);return out;}
