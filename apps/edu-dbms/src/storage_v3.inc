// Format 3 table and access-method adapter. Included inside Storage::Impl.
// Every access page is owned by a table and participates in the same private
// page overlay, checksummed redo WAL, checkpoint and recovery protocol as heaps.
void capture_positions(const std::shared_ptr<Transaction>& tx,PageId owner,PageId page,const json& value){
    if(value.value("kind",std::string())=="hash_probe"){
        for(const auto& e:value.at("slots"))if(e.is_array()&&e.size()==3&&e[2].is_array())tx->state->moved_rows[owner][e[1].get<std::uint64_t>()]=page;
    }else if(value.contains("entries")&&(value.value("leaf",false)||value.value("kind",std::string())=="hash_bucket")){
        for(const auto& e:value.at("entries"))if(e.is_array()&&e.size()==3&&e[2].is_array())tx->state->moved_rows[owner][e[1].get<std::uint64_t>()]=page;
    }
}
access::Pager pager(const std::shared_ptr<Transaction>& tx,PageId owner,bool data_pages=false){
    access::Pager p;
    p.page_size_budget=7600;
    p.read=[this,tx,owner,data_pages](PageId id){auto page=read_page(tx,id);if(get16(page.data()+6)!=TYPE_ACCESS||get64(page.data()+40)!=owner)throw DbError("CORRUPT_INDEX","Access page owner/type mismatch");auto value=parse_json(read_blob(tx,id,TYPE_ACCESS));auto kind=value.value("kind",std::string());bool record_page=data_pages&&(kind=="ordered_data"||kind=="hash_bucket"||kind=="hash_probe");if(data_pages&&value.value("leaf",false)&&value.contains("entries")){const auto& es=value.at("entries");record_page=es.empty()||(es[0].is_array()&&es[0].size()==3&&(es[0][2].is_array()||es[0][2].is_string()));}if(record_page){++heap_reads;++tx->state->heap_reads;}else{++index_reads;++tx->state->index_reads;}return value;};
    p.write=[this,tx,owner,data_pages](PageId id,const json& value){write_blob(tx,id,TYPE_ACCESS,value.dump());auto page=read_page(tx,id);put64(page.data()+40,owner);private_page(tx,id,page);if(data_pages)capture_positions(tx,owner,id,value);};
    p.allocate=[this,tx,owner,data_pages](const json& value){auto id=allocate(tx,TYPE_ACCESS,owner);write_blob(tx,id,TYPE_ACCESS,value.dump());auto page=read_page(tx,id);put64(page.data()+40,owner);private_page(tx,id,page);if(data_pages)capture_positions(tx,owner,id,value);return id;};
    p.retire=[this,tx](PageId id){auto page=read_page(tx,id);auto next=get64(page.data()+24);retire(tx,id);while(next){auto q=read_page(tx,next);auto after=get64(q.data()+24);retire(tx,next);next=after;}};
    return p;
}
static json rid_json(const RowId& r){return json::array({r.page_id,r.slot_id,r.generation});}
static RowId decode_rid(const json& j,std::uint64_t lid){return {j.at(0).get<PageId>(),j.at(1).get<std::uint16_t>(),j.at(2).get<std::uint32_t>(),lid};}
static std::vector<std::size_t> column_numbers(const json& meta,const json& names){std::vector<std::size_t> out;for(const auto& n:names){bool found=false;for(std::size_t i=0;i<meta.at("columns").size();++i)if(meta.at("columns")[i].at("name")==n){out.push_back(i);found=true;break;}if(!found)throw DbError("COLUMN_NOT_FOUND","Index/organization column not found");}return out;}
static json key_for(const json& row,const json& columns){json key=json::array();for(const auto& c:columns)key.push_back(row.at(c.get<std::size_t>()));return key;}
json index_definition(const json& meta,json ix){
    if(!ix.contains("columns"))ix["columns"]=json::array({ix.at("column")});
    if(ix.at("columns").empty())throw DbError("INVALID_INDEX","Empty index key");
    ix["column"]=ix.at("columns")[0];ix["column_numbers"]=column_numbers(meta,ix.at("columns"));ix["column_index"]=ix["column_numbers"][0];
    ix["method"]=ix.value("method",std::string("BPLUS"));ix["include"]=ix.value("include",json::array());ix["include_numbers"]=column_numbers(meta,ix["include"]);ix["options"]=ix.value("options",json::object());
    (void)access::capabilities(ix.at("method").get<std::string>());
    for(const auto& c:ix["column_numbers"])if(meta.at("columns")[c.get<std::size_t>()].at("type")=="BLOB")throw DbError("INVALID_INDEX","BLOB search keys are not supported");
    for(const auto& c:ix["include_numbers"])if(meta.at("columns")[c.get<std::size_t>()].at("type")=="BLOB")throw DbError("INVALID_INDEX","BLOB included values are not supported");
    if(ix["method"]=="BITMAP"&&(ix["columns"].size()!=1||ix.value("unique",false)||!ix["include"].empty()))throw DbError("INVALID_INDEX","BITMAP requires one non-unique column without INCLUDE");
    if(!ix["include"].empty()&&ix["method"]!="BPLUS"&&ix["method"]!="BTREE")throw DbError("INVALID_INDEX","INCLUDE requires BPLUS or BTREE");
    if(ix["method"]=="ORDERED_SPARSE"){
        auto org=meta.value("organization",json{{"method","HEAP"}});if(org.value("method",std::string("HEAP"))!="ORDERED")throw DbError("INVALID_INDEX","Sparse index requires an ORDERED file");
        auto keys=org.value("columns",json::array());if(ix["options"].value("multilevel",org.value("options",json::object()).value("multilevel",true))!=org.value("options",json::object()).value("multilevel",true))throw DbError("INVALID_INDEX_ORGANIZATION","Sparse directory mode must match ORDERED organization; reorganization is explicit");if(keys.size()<ix["columns"].size())throw DbError("INVALID_INDEX","Sparse key must prefix organization key");for(std::size_t i=0;i<ix["columns"].size();++i)if(keys[i]!=ix["columns"][i])throw DbError("INVALID_INDEX","Sparse key must match physical ordering");
    }
    return ix;
}
json org_definition(const json& meta){auto o=meta.value("organization",json{{"method","HEAP"},{"columns",json::array()},{"options",json::object()}});if(o.is_string())o={{"method",o},{"columns",json::array()}};o["method"]=o.value("method",std::string("HEAP"));o["columns"]=o.value("columns",json::array());o["options"]=o.value("options",json::object());
    auto m=o["method"].get<std::string>();if(m!="HEAP"&&m!="ORDERED"&&m!="BPLUS"&&m!="HASH_STATIC"&&m!="HASH_EXTENDIBLE"&&m!="HASH_LINEAR")throw DbError("INVALID_ORGANIZATION","Unsupported organization");
    if(m!="HEAP"&&o["columns"].empty())throw DbError("INVALID_ORGANIZATION","Organization key required");o["column_numbers"]=column_numbers(meta,o["columns"]);for(const auto& c:o["column_numbers"])if(meta["columns"][c.get<std::size_t>()]["type"]=="BLOB")throw DbError("INVALID_ORGANIZATION","BLOB organization key unsupported");return o;
}
std::string org_method(const json& d){return d.at("organization").at("method").get<std::string>();}
json externalize(const std::shared_ptr<Transaction>& tx,PageId owner,const json& row,const json& previous=json(),const json& previous_values=json()){json result=row;for(std::size_t position=0;position<result.size();++position){auto& value=result[position];if(!(value.is_object()&&value.contains("$blob")))continue;if(previous.is_array()&&position<previous.size()&&previous_values.is_array()&&row[position]==previous_values[position]){value=previous[position];continue;}
    auto bytes=value.at("$blob").get<std::string>();if(bytes.size()%2||bytes.size()>32u*1024u*1024u)throw DbError("BLOB_TOO_LARGE","BLOB maximum is 16 MiB");
    json tree={{"method","BPLUS"},{"options",json::object()}};access::Index index(pager(tx,owner),tree);index.initialize();
    for(std::size_t off=0;off<bytes.size();off+=6144)index.insert({json::array({off/2}),static_cast<std::uint64_t>(off/6144+1),bytes.substr(off,6144)});
    value={{"$lob",tree},{"bytes",bytes.size()/2},{"owner",owner}};
}return result;}
json hydrate(const std::shared_ptr<Transaction>& tx,PageId owner,const json& row){json result=row;for(auto& v:result)if(v.is_object()&&v.contains("$lob")){auto tree=v.at("$lob");access::Index index(pager(tx,owner,true),tree);std::string hex;for(const auto& e:index.all())hex+=e.payload.get<std::string>();if(hex.size()!=v.at("bytes").get<std::size_t>()*2)throw DbError("CORRUPT_BLOB","BLOB length mismatch");v={{"$blob",hex}};}return result;}
void retire_objects(const std::shared_ptr<Transaction>& tx,PageId owner,const json& row){for(const auto& v:row)if(v.is_object()&&v.contains("$lob")){auto d=v.at("$lob");access::Index index(pager(tx,owner),d);index.clear();}}
RowId v3_heap_insert(const std::shared_ptr<Transaction>& tx,PageId owner,json& desc,const json& row,std::uint64_t lid){auto bytes=pack_heap_record(desc,lid,row);if(bytes.size()>PAGE_SIZE-PAGE_HEADER-SLOT_SIZE)throw DbError("ROW_TOO_LARGE","Row cannot fit an 8KiB page after BLOB externalization");auto& free=desc["free_space"];std::vector<PageId> candidates;
    for(auto it=free.begin();it!=free.end();++it)if(it.value().get<std::size_t>()>=bytes.size()+SLOT_SIZE)candidates.push_back(std::stoull(it.key()));
    if(!desc["heap"].empty()){auto last=desc["heap"].back().get<PageId>();auto i=std::find(candidates.begin(),candidates.end(),last);if(i!=candidates.end())std::rotate(candidates.begin(),i,i+1);}
    for(auto id:candidates){auto page=heap_page(tx,id,owner);auto r=heap_append(page,bytes);free[std::to_string(id)]=get16(page.data()+36)-get16(page.data()+34);if(r){r->logical_id=lid;private_page(tx,id,page);return *r;}}
    auto id=allocate(tx,TYPE_HEAP,owner);auto page=read_page(tx,id);if(!desc["heap"].empty()){auto last=desc["heap"].back().get<PageId>();auto before=heap_page(tx,last,owner);put64(before.data()+24,id);private_page(tx,last,before);put64(page.data()+48,last);}auto r=heap_append(page,bytes);if(!r)throw DbError("ROW_TOO_LARGE","Row cannot fit page");r->logical_id=lid;private_page(tx,id,page);desc["heap"].push_back(id);free[std::to_string(id)]=get16(page.data()+36)-get16(page.data()+34);return *r;
}
json map_locator(const std::shared_ptr<Transaction>& tx,PageId owner,json& desc,std::uint64_t lid){access::Index index(pager(tx,owner),desc["row_map"]);auto entries=index.find(json::array({lid}));if(entries.size()!=1)throw DbError("STALE_ROW_ID","Logical row is missing");return entries[0].payload;}
void set_locator(const std::shared_ptr<Transaction>& tx,PageId owner,json& desc,std::uint64_t lid,const json& locator,bool replace){access::Index index(pager(tx,owner),desc["row_map"]);if(replace&&!index.erase(json::array({lid}),lid))throw DbError("CORRUPT_INDEX","Missing row-map entry");index.insert({json::array({lid}),lid,locator});}
json stored_at(const std::shared_ptr<Transaction>& tx,PageId owner,json& desc,std::uint64_t lid,RowId* physical=nullptr){if(clustered(desc))return cluster_stored(tx,owner,desc,lid,physical);auto loc=map_locator(tx,owner,desc,lid);if(org_method(desc)=="HEAP"){
    auto rid=decode_rid(loc.at("rid"),lid);auto page=heap_page(tx,rid.page_id,owner);if(!slot_length(page,rid.slot_id)||slot_generation(page,rid.slot_id)!=rid.generation)throw DbError("STALE_ROW_ID","Deleted/reused physical slot");auto j=unpack_heap_record(desc,slot(page,rid.slot_id));if(j.at("id")!=lid)throw DbError("CORRUPT_PAGE","Logical/physical identity mismatch");if(physical)*physical=rid;return j.at("row");
}access::Index index(pager(tx,owner,true),desc["organization_index"]);for(const auto& e:index.find(loc.at("key")))if(e.id==lid){if(physical)*physical=RowId{loc.value("page",PageId(0)),0,1,lid};return e.payload;}throw DbError("CORRUPT_INDEX","Organization row is missing");}
void v3_check_unique(const std::shared_ptr<Transaction>& tx,PageId owner,json& desc,const json& row,std::uint64_t ignore=0){for(auto& ix:desc["index_roots"]){if(!ix.value("unique",false))continue;auto k=key_for(row,ix.at("column_numbers"));bool null=false;for(const auto& v:k)null|=v.is_null();if(null)continue;
    if(ix.value("organization_alias",false)){access::Index org(pager(tx,owner,true),desc["organization_index"]);auto next=org.cursor(k,{},true,true);access::Entry e;while(next(e)){json prefix=json::array();for(std::size_t i=0;i<k.size();++i)prefix.push_back(e.key[i]);if(access::compare_keys(prefix,k)>0)break;if(e.id!=ignore)throw DbError("UNIQUE_VIOLATION","Duplicate sparse key in "+ix.at("name").get<std::string>());}continue;}
    access::Index index(pager(tx,owner),ix);for(const auto& e:index.find(k))if(e.id!=ignore)throw DbError("UNIQUE_VIOLATION","Duplicate key in index "+ix.at("name").get<std::string>());
}}
json secondary_payload(const json& desc,const json& ix,const json& row,const RowId& physical){json covered=json::object();for(const auto& c:ix.at("column_numbers"))covered[std::to_string(c.get<std::size_t>())]=row[c.get<std::size_t>()];for(const auto& c:ix.at("include_numbers"))covered[std::to_string(c.get<std::size_t>())]=row[c.get<std::size_t>()];auto indirect=org_method(desc)!="HEAP"&&ix.at("options").value("locator",std::string("primary"))!="direct";json ref=indirect?json{{"kind","primary"},{"key",key_for(row,desc["organization"]["column_numbers"])}}:json{{"kind","physical"},{"rid",rid_json(physical)}};if(!indirect&&org_method(desc)!="HEAP")ref["key"]=key_for(row,desc["organization"]["column_numbers"]);return {{"cover",covered},{"ref",ref}};}
RowId v3_insert(const std::shared_ptr<Transaction>& tx,const std::string& name,const json& row,std::uint64_t forced_lid=0){auto pair=descriptor(tx,name);auto owner=pair.first;auto& d=pair.second;if(row.size()!=d["meta"]["columns"].size())throw DbError("INVALID_ROW","Row width mismatch");v3_check_unique(tx,owner,d,row);auto lid=forced_lid?forced_lid:d.value("next_row_id",std::uint64_t(1));if(lid==std::numeric_limits<std::uint64_t>::max())throw DbError("DATABASE_TOO_LARGE","Logical row id exhausted");d["next_row_id"]=std::max(d.value("next_row_id",std::uint64_t(1)),lid+1);auto encoded=externalize(tx,owner,row);RowId rid{0,0,1,lid};json loc;
    if(clustered(d)){rid=cluster_insert(tx,owner,d,encoded,lid);loc={{"rid",rid_json(rid)}};}else if(org_method(d)=="HEAP"){rid=v3_heap_insert(tx,owner,d,encoded,lid);loc={{"rid",rid_json(rid)}};}else{auto k=key_for(row,d["organization"]["column_numbers"]);access::Index org(pager(tx,owner,true),d["organization_index"]);org.insert({k,lid,encoded});auto page=org.locate(k,lid);if(!page)throw DbError("CORRUPT_INDEX","Inserted organized row is missing");rid={*page,0,1,lid};loc={{"key",k},{"page",*page}};}
    if(!clustered(d))set_locator(tx,owner,d,lid,loc,false);for(auto& ix:d["index_roots"]){if(ix.value("organization_alias",false))continue;access::Index index(pager(tx,owner),ix);index.insert({key_for(row,ix["column_numbers"]),lid,secondary_payload(d,ix,row,rid)});}d["row_count"]=d.at("row_count").get<std::uint64_t>()+1;ch10_bump(d,"data_version");flush_moves(tx,owner,d);save_desc(tx,owner,d);return rid;
}
RowId v3_update(const std::shared_ptr<Transaction>& tx,const std::string& name,const RowId& rid,const json& row){auto pair=descriptor(tx,name);auto owner=pair.first;auto& d=pair.second;auto original=d;auto lid=rid.logical_id;if(!lid)throw DbError("STALE_ROW_ID","Format 3 updates require logical identity");RowId actual;auto old_encoded=stored_at(tx,owner,d,lid,&actual);if(org_method(d)=="HEAP"&&rid.page_id&&(!(actual==rid)))throw DbError("STALE_ROW_ID","Physical row moved");auto old=hydrate(tx,owner,old_encoded);if(old==row)return actual;v3_check_unique(tx,owner,d,row,lid);auto encoded=externalize(tx,owner,row,old_encoded,old);RowId after=actual;json loc;
    if(clustered(d)){after=cluster_update(tx,owner,d,encoded,lid);loc={{"rid",rid_json(after)}};}else if(org_method(d)=="HEAP"){auto page=heap_page(tx,actual.page_id,owner);auto bytes=pack_heap_record(d,lid,encoded);if(repack(page,actual.slot_id,bytes,false)){private_page(tx,actual.page_id,page);d["free_space"][std::to_string(actual.page_id)]=get16(page.data()+36)-get16(page.data()+34);}else{repack(page,actual.slot_id,"",false);private_page(tx,actual.page_id,page);d["free_space"][std::to_string(actual.page_id)]=get16(page.data()+36)-get16(page.data()+34);after=v3_heap_insert(tx,owner,d,encoded,lid);}loc={{"rid",rid_json(after)}};
    }else{access::Index org(pager(tx,owner,true),d["organization_index"]);if(!org.erase(key_for(old,d["organization"]["column_numbers"]),lid))throw DbError("CORRUPT_INDEX","Missing old organization entry");auto k=key_for(row,d["organization"]["column_numbers"]);org.insert({k,lid,encoded});auto page=org.locate(k,lid);if(!page)throw DbError("CORRUPT_INDEX","Updated organized row is missing");after={*page,0,1,lid};loc={{"key",k},{"page",*page}};}
    for(auto& ix:d["index_roots"]){if(ix.value("organization_alias",false))continue;auto oldkey=key_for(old,ix["column_numbers"]),newkey=key_for(row,ix["column_numbers"]);auto before=secondary_payload(d,ix,old,actual),next=secondary_payload(d,ix,row,after);if(oldkey==newkey&&before==next)continue;access::Index index(pager(tx,owner),ix);if(!index.erase(oldkey,lid))throw DbError("CORRUPT_INDEX","Missing secondary entry");index.insert({newkey,lid,next});}
    if(map_locator(tx,owner,d,lid)!=loc)set_locator(tx,owner,d,lid,loc,true);for(std::size_t i=0;i<old_encoded.size();++i)if(old_encoded[i].is_object()&&old_encoded[i].contains("$lob")&&old_encoded[i]!=encoded[i])retire_objects(tx,owner,json::array({old_encoded[i]}));ch10_bump(d,"data_version");flush_moves(tx,owner,d);if(d!=original)save_desc(tx,owner,d);return after;
}
void v3_erase(const std::shared_ptr<Transaction>& tx,const std::string& name,const RowId& rid){auto pair=descriptor(tx,name);auto owner=pair.first;auto& d=pair.second;auto lid=rid.logical_id;if(!lid)throw DbError("STALE_ROW_ID","Missing logical identity");RowId actual;auto encoded=stored_at(tx,owner,d,lid,&actual);if(org_method(d)=="HEAP"&&rid.page_id&&(!(actual==rid)))throw DbError("STALE_ROW_ID","Physical row moved");auto row=hydrate(tx,owner,encoded);for(auto& ix:d["index_roots"]){if(ix.value("organization_alias",false))continue;access::Index index(pager(tx,owner),ix);if(!index.erase(key_for(row,ix["column_numbers"]),lid))throw DbError("CORRUPT_INDEX","Missing secondary entry");}
    if(clustered(d)){cluster_erase(tx,owner,d,lid);}else if(org_method(d)=="HEAP"){auto page=heap_page(tx,actual.page_id,owner);repack(page,actual.slot_id,"",false);private_page(tx,actual.page_id,page);d["free_space"][std::to_string(actual.page_id)]=get16(page.data()+36)-get16(page.data()+34);}else{access::Index org(pager(tx,owner,true),d["organization_index"]);org.erase(key_for(row,d["organization"]["column_numbers"]),lid);}if(!clustered(d)){access::Index map(pager(tx,owner),d["row_map"]);map.erase(json::array({lid}),lid);}retire_objects(tx,owner,encoded);d["row_count"]=d.at("row_count").get<std::uint64_t>()-1;ch10_bump(d,"data_version");flush_moves(tx,owner,d);save_desc(tx,owner,d);
}
static int compare_scalar(const json& a,const json& b){return access::compare_keys(json::array({a}),json::array({b}));}

void flush_moves(const std::shared_ptr<Transaction>& tx,PageId owner,json& d){
    auto moved=std::move(tx->state->moved_rows[owner]);tx->state->moved_rows.erase(owner);if(org_method(d)=="HEAP")return;
    access::Index mapping(pager(tx,owner),d["row_map"]);access::Index organization(pager(tx,owner,true),d["organization_index"]);
    for(const auto& change:moved){auto lid=change.first,page=change.second;auto found=mapping.find(json::array({lid}));if(found.empty())continue;auto locator=found[0].payload;if(locator.value("page",PageId(0))==page)continue;
        auto record=organization.read_at(page,locator.at("key"),lid);if(!record)throw DbError("CORRUPT_INDEX","Relocated record not found at its new page");
        locator["page"]=page;mapping.erase(json::array({lid}),lid);mapping.insert({json::array({lid}),lid,locator});
        for(auto& ix:d["index_roots"]){if(ix.value("organization_alias",false)||ix.at("options").value("locator",std::string("primary"))!="direct")continue;access::Index index(pager(tx,owner),ix);auto key=key_for(record->payload,ix["column_numbers"]);for(auto entry:index.find(key))if(entry.id==lid){auto payload=entry.payload;payload["ref"]["rid"]=json::array({page,0,1});if(payload!=entry.payload){index.erase(key,lid);entry.payload=payload;index.insert(entry);}break;}}
    }
}
StoredRow fetch_entry(const std::shared_ptr<Transaction>& tx,PageId owner,json& desc,const json& ix,const access::Entry& entry,const ScanSpec& spec){
    StoredRow row;row.id={0,0,1,entry.id};bool cover=spec.projection_known&&!ix.is_null()&&!ix.value("organization_alias",false)&&entry.payload.is_object()&&entry.payload.contains("cover");
    if(cover)for(auto c:spec.required_columns)if(!entry.payload.at("cover").contains(std::to_string(c)))cover=false;
    if(cover){row.values=json::array();for(std::size_t i=0;i<desc["meta"]["columns"].size();++i)row.values.push_back(entry.payload["cover"].value(std::to_string(i),json(nullptr)));if(entry.payload.contains("ref")&&entry.payload["ref"].contains("rid"))row.id=decode_rid(entry.payload["ref"]["rid"],entry.id);++tx->state->cover_hits;return row;}
    json encoded;
    if(!ix.is_null()&&ix.value("organization_alias",false)){encoded=entry.payload;access::Index org(pager(tx,owner,true),desc["organization_index"]);auto position=org.locate(entry.key,entry.id);if(position)row.id.page_id=*position;}
    else if(entry.payload.is_object()&&entry.payload.contains("ref")&&org_method(desc)!="HEAP"){
        const auto& ref=entry.payload.at("ref");access::Index org(pager(tx,owner,true),desc["organization_index"]);bool found=false;
        if(ref.value("kind",std::string())=="physical"&&ref.contains("key")){auto physical=decode_rid(ref.at("rid"),entry.id);auto value=org.read_at(physical.page_id,ref.at("key"),entry.id);if(value){encoded=value->payload;row.id=physical;found=true;}}
        else{auto page=org.locate(ref.at("key"),entry.id);if(page){auto value=org.read_at(*page,ref.at("key"),entry.id);if(value){encoded=value->payload;row.id.page_id=*page;found=true;}}}
        if(!found)throw DbError("CORRUPT_INDEX","Secondary reference is stale");
    }else encoded=stored_at(tx,owner,desc,entry.id,&row.id);
    row.values=spec.lazy_blobs?encoded:hydrate(tx,owner,encoded);++tx->state->rows_fetched;return row;
}
// Truth value: -1 UNKNOWN, 0 FALSE, 1 TRUE. Unsupported leaves conservatively
// return UNKNOWN and must never be used to eliminate candidates.
static int condition_truth(const json& ast,const json& row){if(ast.is_null())return 1;auto op=ast.value("op",std::string());if(op=="AND"||op=="OR"){int result=op=="AND"?1:0;for(const auto& a:ast.at("args")){int v=condition_truth(a,row);if(op=="AND"){if(!v)return 0;if(v<0)result=-1;}else{if(v==1)return 1;if(v<0)result=-1;}}return result;}if(op=="NOT"){int v=condition_truth(ast.at("args")[0],row);return v<0?-1:1-v;}
    auto c=ast.value("column",-1);if(c<0||std::size_t(c)>=row.size())return -1;const auto& value=row[c];if(op=="IS NULL")return value.is_null();if(op=="IS NOT NULL")return !value.is_null();const auto& other=ast.at("value");if(value.is_null()||other.is_null())return -1;int cmp=compare_scalar(value,other);if(op=="=")return cmp==0;if(op=="!="||op=="<>")return cmp!=0;if(op=="<")return cmp<0;if(op=="<=")return cmp<=0;if(op==">")return cmp>0;if(op==">=")return cmp>=0;return -1;
}
static void leaves_for(const json& condition,int column,std::vector<json>& leaves){if(condition.is_null())return;auto op=condition.value("op",std::string());if(op=="AND"){for(const auto& c:condition.at("args"))leaves_for(c,column,leaves);}else if(condition.value("column",-1)==column&&op!="NOT"&&op!="OR")leaves.push_back(condition);}
std::vector<access::Entry> candidates(const std::shared_ptr<Transaction>& tx,PageId owner,json& ix,const ScanSpec& spec){access::Index index(pager(tx,owner),ix);json lower=spec.lower_key,upper=spec.upper_key;bool li=spec.lower_inclusive,ui=spec.upper_inclusive;
    if(lower.is_null()&&spec.lower)lower=json::array({*spec.lower});if(upper.is_null()&&spec.upper)upper=json::array({*spec.upper});
    if(lower.is_null()&&upper.is_null()){json prefix=json::array();for(const auto& c:ix.at("column_numbers")){std::vector<json> constraints;leaves_for(spec.condition,c.get<int>(),constraints);json eq=nullptr;bool has_eq=false;for(const auto& v:constraints)if(v["op"]=="="||v["op"]=="IS NULL"){eq=v.value("value",json(nullptr));has_eq=true;break;}if(has_eq){prefix.push_back(eq);continue;}if(!prefix.empty()){lower=prefix;upper=prefix;}for(const auto& v:constraints){auto op=v["op"].get<std::string>();if(op==">"||op==">="){auto k=prefix;k.push_back(v.at("value"));if(lower.is_null()||access::compare_keys(k,lower)>0){lower=k;li=op==">=";}}if(op=="<"||op=="<="){auto k=prefix;k.push_back(v.at("value"));if(upper.is_null()||access::compare_keys(k,upper)<0){upper=k;ui=op=="<=";}}}break;}if(lower.is_null()&&upper.is_null()&&!prefix.empty()){lower=prefix;upper=prefix;}}
    // Prefix bounds are checked after seeking the common prefix; no fake -inf
    // or +inf sentinel can collide with a user scalar.
    if(!lower.is_null()&&!upper.is_null()&&lower==upper&&lower.size()==ix.at("column_numbers").size())return index.find(lower);
    std::optional<access::Key> lo,hi;if(!lower.is_null())lo=lower;if(!upper.is_null()&&upper.size()==ix.at("column_numbers").size())hi=upper;
    auto result=index.range(lo,hi,li,ui);if(!upper.is_null()&&upper.size()<ix.at("column_numbers").size())result.erase(std::remove_if(result.begin(),result.end(),[&](const auto& e){json p=json::array();for(std::size_t i=0;i<upper.size();++i)p.push_back(e.key[i]);return access::compare_keys(p,upper)>0;}),result.end());return result;
}
